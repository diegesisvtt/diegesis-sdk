{
  "name": "@diegesis/audio",
  "version": "0.2.2",
  "description": "Howler-based audio engine for Diegesis: channels with mute/solo, fades, random groups, spatial sound and timelines.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/audio"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/events": "^0.2.1",
    "howler": "^2.2.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "audio",
    "howler",
    "spatial",
    "ambience",
    "vtt",
    "tabletop"
  ]
}
