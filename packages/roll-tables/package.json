{
  "name": "@diegesis/roll-tables",
  "version": "0.2.0",
  "description": "Weighted random roll tables for Diegesis — Foundry-grade draws plus seeded RNG, conditional entries, deck policies, nested resolution with cycle detection, and probability analysis.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/roll-tables"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/dice-core": "workspace:*",
    "@diegesis/dice-notation": "workspace:*",
    "@diegesis/events": "workspace:*",
    "@diegesis/formula": "workspace:*",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "rolltable",
    "random-tables",
    "vtt",
    "foundry",
    "weighted",
    "dice"
  ]
}
