{
  "name": "@diegesis/dice-notation",
  "version": "0.1.1",
  "description": "Canonical Diegesis dice notation — unambiguous parse/fromFormula and toFormula for the dice IR, the best of Foundry and Roll20 without their collisions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/dice-notation"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/dice-core": "^0.1.1",
    "@diegesis/dice-notation-core": "^0.1.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "valibot": "^1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "dice",
    "notation",
    "parser",
    "foundry",
    "roll20",
    "vtt"
  ]
}
