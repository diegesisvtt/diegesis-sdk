{
  "name": "@diegesis/dice",
  "version": "0.1.0",
  "description": "Framework-agnostic 3D dice roller for Diegesis (three.js + cannon-es worker physics).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/3ddice"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/assets": "workspace:*",
    "@diegesis/audio": "workspace:*",
    "@diegesis/dice-core": "workspace:*",
    "@diegesis/dice-notation": "workspace:*",
    "@diegesis/events": "workspace:*",
    "@diegesis/physics": "workspace:*",
    "@diegesis/render3d": "workspace:*",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "cannon-es": "^0.20.0",
    "three": "^0.182.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "valibot": "^1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["diegesis", "dice", "3d", "vtt", "three.js", "cannon-es"]
}
