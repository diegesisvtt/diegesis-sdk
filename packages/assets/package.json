{
  "name": "@diegesis/assets",
  "version": "0.1.3",
  "description": "Declarative asset packs for Diegesis: content-addressed caching, persistent storage adapters, preload with progress events.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/assets"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/events": "^0.2.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "valibot": "^1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "assets",
    "cache",
    "offline",
    "vtt",
    "preload"
  ]
}
