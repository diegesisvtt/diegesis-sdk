{
  "name": "@diegesis/canvas-plugin-grid",
  "version": "0.2.1",
  "description": "Grid plugin for @diegesis/canvas — renders the scene grid (square, hex, isometric) and contributes grid configuration via context menu.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/canvas-plugin-grid"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/canvas": "workspace:*",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.11.2",
    "pixi.js": "^8.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "canvas",
    "plugin",
    "grid",
    "vtt",
    "tabletop"
  ]
}
