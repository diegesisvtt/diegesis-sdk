{
  "name": "@diegesis/canvas-preset-standard",
  "version": "0.1.0",
  "description": "Standard preset for @diegesis/canvas — bundles the core plugins (grid, maps, tiles, drawings, walls, templates, tokens, rings, lights, measure, lighting, fog) in one import.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/canvas-preset-standard"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/canvas": "workspace:*",
    "@diegesis/canvas-plugin-grid": "workspace:*",
    "@diegesis/canvas-plugin-grid-square": "workspace:*",
    "@diegesis/canvas-plugin-grid-hex": "workspace:*",
    "@diegesis/canvas-plugin-grid-isometric": "workspace:*",
    "@diegesis/canvas-plugin-maps": "workspace:*",
    "@diegesis/canvas-plugin-tiles": "workspace:*",
    "@diegesis/canvas-plugin-drawings": "workspace:*",
    "@diegesis/canvas-plugin-walls": "workspace:*",
    "@diegesis/canvas-plugin-templates": "workspace:*",
    "@diegesis/canvas-plugin-tokens": "workspace:*",
    "@diegesis/canvas-plugin-rings": "workspace:*",
    "@diegesis/canvas-plugin-lights": "workspace:*",
    "@diegesis/canvas-plugin-measure": "workspace:*",
    "@diegesis/canvas-plugin-ranges": "workspace:*",
    "@diegesis/canvas-plugin-lighting": "workspace:*",
    "@diegesis/canvas-plugin-fog": "workspace:*",
    "@diegesis/canvas-plugin-window": "workspace:*",
    "@diegesis/canvas-plugin-image-editor": "workspace:*"
  },
  "peerDependencies": {
    "pixi.js": "^8.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pixi.js": "^8.15.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["diegesis", "canvas", "preset", "plugins", "vtt", "tabletop"]
}
