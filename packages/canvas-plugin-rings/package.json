{
  "name": "@diegesis/canvas-plugin-rings",
  "version": "0.2.1",
  "description": "Colored ring markers for tokens on @diegesis/canvas — presets, custom styles, dash/glow/pulse, event-driven and hook-extensible.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegesisvtt/diegesis-sdk.git",
    "directory": "packages/canvas-plugin-rings"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diegesis/canvas": "workspace:*",
    "valibot": "^1.4.2"
  },
  "peerDependencies": {
    "pixi.js": "^8.15.0",
    "pixi-filters": "^6.1.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/node": "^22.10.0",
    "happy-dom": "^20.11.2",
    "pixi.js": "^8.15.0",
    "pixi-filters": "^6.1.5",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "diegesis",
    "canvas",
    "plugin",
    "ring",
    "marker",
    "token",
    "condition",
    "vtt",
    "tabletop"
  ]
}
