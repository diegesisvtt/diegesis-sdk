{
  "name": "diegesis-sdk",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
